{
  "expo": {
    "name": "SignalDock",
    "slug": "signaldock",
    "version": "0.1.0",
    "scheme": "signaldock",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SignalDock to transmit your voice to the selected radio."
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "org.signaldock.client",
      "supportsTablet": true
    },
    "android": {
      "package": "org.signaldock.client"
    }
  }
}
